// Papagaio rules for C Plugin Preprocessing
// This file is prepended to the C source before processing with Papagaio.

// Match 'export func as name' using the $identifier modifier 
// to ensure we don't swallow semicolons or other punctuation.
$pattern {export $f$identifier as $n$identifier} {__attribute__((export_name("papagaio_$n"))) char *$f(int argc, const char **argv)}

$pattern {export $f$identifier} {__attribute__((export_name("papagaio_$f"))) char *$f(int argc, const char **argv)}
#define PAPAGAIO_WASM_IMPLEMENTATION
#include "papagaio_wasm.h"

/* 
 * Plugin Moderno - Demonstração de Flexibilidade
 */

// Estilo 1: Declaração separada (antes da definição)
export echo as repete;

char *echo(int argc, const char **argv) {
    if (argc < 1) return "";
    return (char*)argv[0];
}

// Estilo 2: Prefixo (define e exporta ao mesmo tempo)
export hello
{
    return "Olá do estilo prefixo!";
}

// Estilo 3: Declaração separada (depois da definição)
char *calculate_pi(int argc, const char **argv) {
    (void)argc; (void)argv;
    return "3.14159";
}
export calculate_pi as pi;
