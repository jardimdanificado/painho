/* Minimal Libc - Desenvolvedor tem total controle */
typedef unsigned int  uint32_t;
typedef unsigned long size_t;
extern unsigned char __heap_base;
static unsigned char *hptr;
void *malloc(size_t n) {
    if (!hptr) hptr = &__heap_base;
    void *p = hptr; hptr += (n + 7) & ~7; return p;
}
void free(void *p) { (void)p; }
size_t strlen(const char *s) { const char *a = s; while (*s) s++; return s - a; }
char *strcat(char *d, const char *s) { char *a = d; while (*d) d++; while ((*d++ = *s++)) { ; } return a; }
int atoi(const char *s) { int n = 0; while (*s >= '0' && *s <= '9') n = n * 10 + (*s++ - '0'); return n; }

$wasm_plugin{repetir}{
    if (argc < 2) return "Uso: repetir {palavra} {vezes}";
    const char *word = argv[0];
    int n = atoi(argv[1]);
    if (n <= 0) n = 1;

    size_t sz = strlen(word) * n + n + 1;
    char *res = (char*)malloc(sz);
    res[0] = '\0';
    for (int i = 0; i < n; i++) {
        strcat(res, word);
        if (i < n-1) strcat(res, " ");
    }
    return res;
}
