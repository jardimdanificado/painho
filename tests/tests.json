{
  "tests": [
    {
      "id": 1,
      "name": "Basic variable substitution",
      "code": "$pattern {$x $y} {$y, $x}\nhello world",
      "expected": "world, hello"
    },
    {
      "id": 2,
      "name": "Flexible whitespace with $",
      "code": "$pattern {$x and $y} {$x & $y}\nhello   and   world",
      "expected": "hello & world"
    },
    {
      "id": 3,
      "name": "Block with custom delimiters",
      "code": "$pattern {$content$block{(}{)}} {[$content]}\ndata (hello world)",
      "expected": "data [hello world]"
    },
    {
      "id": 4,
      "name": "Block with multi-char delimiters",
      "code": "$pattern {$code$block{<<}{>>}} {CODE[$code]}\n<<console.log()>>",
      "expected": "CODE[console.log()]"
    },
    {
      "id": 5,
      "name": "Block with nested delimiters",
      "code": "$pattern {$txt$block{<}{>}} {[$txt]}\nouter <middle <inner> content>",
      "expected": "outer [middle <inner> content]"
    },
    {
      "id": 6,
      "name": "$byte accumulation via repeat",
      "code": "$A$from{}$repeat{3}{$A$byte{65}}$A",
      "expected": "AAA"
    },
    {
      "id": 7,
      "name": "$repeat basic list mutation",
      "code": "$L$from{a}$repeat{3}{$L$list{,}$push{x}}$L",
      "expected": "a,x,x,x"
    },
    {
      "id": 8,
      "name": "Multiple patterns cascade",
      "code": "$pattern {a} {b}\n$pattern {b} {c}\na",
      "expected": "c"
    },
    {
      "id": 9,
      "name": "Global pattern matching",
      "code": "$pattern {x} {X}\nx y x z x",
      "expected": "X y X z X"
    },
    {
      "id": 10,
      "name": "Pattern with special regex characters",
      "code": "$pattern {a.*b} {MATCHED}\na.*b",
      "expected": "MATCHED"
    },
    {
      "id": 11,
      "name": "Multiple blocks in one pattern",
      "code": "$pattern {$a$block{(}{)}  and $b$block{[}{]}} {$a|$b}\n(first) and [second]",
      "expected": "first|second"
    },
    {
      "id": 12,
      "name": "Variable reuse in replacement",
      "code": "$pattern {$x} {$x:$x}\ndata",
      "expected": "data:data"
    },
    {
      "id": 13,
      "name": "Sigil escaping in replacement",
      "code": "$pattern {foo} {$sigil$foo}\nfoo",
      "expected": "$foo"
    },
    {
      "id": 14,
      "name": "Optional whitespace with $ optional",
      "code": "$pattern {hello $world$group{optional}?} {HI}\nhello optional",
      "expected": "HI"
    },
    {
      "id": 15,
      "name": "Block with angle brackets",
      "code": "$pattern {$inner$block{<}{>}} {WRAPPED[$inner]}\n<content>",
      "expected": "WRAPPED[content]"
    },
    {
      "id": 16,
      "name": "Pattern with literal characters",
      "code": "$pattern {Mr. $name} {Hello $name}\nMr. Smith",
      "expected": "Hello Smith"
    },
    {
      "id": 17,
      "name": "$while list depletion",
      "code": "$L$from{1,1,1}$while{1}{$L$list{,}$pop}",
      "expected": "1"
    },
    {
      "id": 18,
      "name": "Block capturing with square brackets",
      "code": "$pattern {$arr$block{[}{]}} {ARRAY[$arr]}\n[1, 2, 3]",
      "expected": "ARRAY[1, 2, 3]"
    },
    {
      "id": 19,
      "name": "Pattern without whitespace matching",
      "code": "$pattern {$a,$b} {$b,$a} one,two",
      "expected": "two,one"
    },
    {
      "id": 20,
      "name": "Nested pattern in replacement",
      "code": "$pattern {$x} {->$x<-}\ntext",
      "expected": "->text<-"
    },
    {
      "id": 21,
      "name": "First pattern applies, second doesn't match",
      "code": "$pattern {hello} {goodbye}\n$pattern {goodbye} {hi}\nhello",
      "expected": "hi"
    },
    {
      "id": 22,
      "name": "Block delimiter balancing - parentheses",
      "code": "$pattern {$code$block{(}{)}} {RESULT[$code]}\n(a (b (c) d) e)",
      "expected": "RESULT[a (b (c) d) e]"
    },
    {
      "id": 23,
      "name": "Block delimiter balancing - angle brackets",
      "code": "$pattern {$inner$block{<}{>}} {X[$inner]}\n<outer <middle <deep>> more>",
      "expected": "X[outer <middle <deep>> more]"
    },
    {
      "id": 24,
      "name": "Block delimiter balancing - square brackets",
      "code": "$pattern {$data$block{[}{]}} {DATA[$data]}\n[outer [inner [deep]] more]",
      "expected": "DATA[outer [inner [deep]] more]"
    },
    {
      "id": 25,
      "name": "Block delimiter balancing - curly braces",
      "code": "$pattern {$obj$block{{}{}}} {OBJ[$obj]}\n{key: {nested: {value}}}",
      "expected": "{key: OBJ[nested: {value}]"
    },
    {
      "id": 26,
      "name": "Multiple nested delimiters in same pattern",
      "code": "$pattern {$a$block{(}{)} $b$block{[}{]}} {[$a|$b]}\n(test1) [test2]",
      "expected": "[test1|test2]"
    },
    {
      "id": 27,
      "name": "Simple pattern cascade",
      "code": "$pattern {START $x END} {RESULT[$x]}\nSTART data END",
      "expected": "RESULT[data]"
    },
    {
      "id": 28,
      "name": "Block with quotes as delimiters",
      "code": "$pattern {$str$block{\"}{\"}} {STRING[$str]}\n\"hello world\"",
      "expected": "STRING[hello world]"
    },
    {
      "id": 29,
      "name": "Block with pipe delimiters",
      "code": "$pattern {$val$block{|}{|}} {PIPE[$val]}\n|content here|",
      "expected": "PIPE[content here]"
    },
    {
      "id": 30,
      "name": "Deeply nested block delimiters",
      "code": "$pattern {$deep$block{<}{>}} {[$deep]}\n<a <b <c <d> c> b> a>",
      "expected": "[a <b <c <d> c> b> a]"
    },
    {
      "id": 31,
      "name": "Two sequential patterns",
      "code": "$pattern {$content$block{(}{)}} {BLOCK [$content]}\n$pattern {BLOCK $x} {RESULT: $x}\n(inner data)",
      "expected": "RESULT: [inner data]"
    },
    {
      "id": 32,
      "name": "$byte Hello World",
      "code": "$byte{72}$byte{101}$byte{108}$byte{108}$byte{111}$byte{44}$byte{32}$byte{87}$byte{111}$byte{114}$byte{108}$byte{100}$byte{33}",
      "expected": "Hello, World!"
    },
    {
      "id": 33,
      "name": "Block delimiter edge case - empty content",
      "code": "$pattern {$empty$block{(}{)}} {EMPTY[$empty]}\n()",
      "expected": "EMPTY[]"
    },
    {
      "id": 34,
      "name": "Multi-char delimiters with nesting",
      "code": "$pattern {$code$block{<<}{>>}} {CODE[$code]}\n<<outer <<inner>> more>>",
      "expected": "CODE[outer <<inner>> more]"
    },
    {
      "id": 35,
      "name": "Cascading pattern transformations",
      "code": "$pattern {START $x END} {STEP1[$x]}\n$pattern {STEP1[$y]} {STEP2[$y]}\n$pattern {STEP2[$z]} {FINAL[$z]}\nSTART test END",
      "expected": "FINAL[test]"
    },
    {
      "id": 36,
      "name": "$while with named aliases",
      "code": "$L$from{a,b,c}$while{$x$aliases{a}{b}}{$L$list{,}$shift}",
      "expected": "b"
    },
    {
      "id": 37,
      "name": "$repeat side-effect emission",
      "code": "$A$from{}$repeat{3}{$A$from{$A.}}$A",
      "expected": "..."
    },
    {
      "id": 38,
      "name": "Integer modifier",
      "code": "$pattern {$n$int} {INT[$n]}\n123 and ABC and -45",
      "expected": "INT[123] and ABC andINT[-45]"
    },
    {
      "id": 39,
      "name": "Float modifier",
      "code": "$pattern {$n$float} {FLT[$n]}\n12.3 and ABC and -4.5",
      "expected": "FLT[12.3] and ABC andFLT[-4.5]"
    },
    {
      "id": 40,
      "name": "Upper and Lower modifiers",
      "code": "$pattern {$u$upper $l$lower} {MATCH}\nHELLO world and HELLO WORLD",
      "expected": "MATCH and HELLO WORLD"
    },
    {
      "id": 41,
      "name": "Capitalized and Word modifiers",
      "code": "$pattern {$c$capitalized $w$word} {MATCH}\nHello world and hello World",
      "expected": "MATCH and hello World"
    },
    {
      "id": 42,
      "name": "Hex modifier",
      "code": "$pattern {$h$hex} {HEX[$h]}\n1a2B and xy",
      "expected": "HEX[1a2B]HEX[a]nHEX[d] xy"
    },
    {
      "id": 43,
      "name": "Binary modifier",
      "code": "$pattern {$b$binary} {BIN[$b]}\n0101 and 123",
      "expected": "BIN[0101] andBIN[1]23"
    },
    {
      "id": 44,
      "name": "Aliases modifier",
      "code": "$pattern {$a$aliases{cat}{dog}} {PET[$a]}\ndog and cat and fish",
      "expected": "PET[dog] andPET[cat] and fish"
    },
    {
      "id": 45,
      "name": "Changequote",
      "code": "$changesymbols{@}{<}{>}{?}@pattern <[@n]> <N:@n> [x] [y]",
      "expected": " N:x N:y"
    },
    {
      "id": 46,
      "name": "Starts modifier",
      "code": "$pattern {$w$starts{pre}} {MATCH[$w]}\nprepare\npremium\npost\npre",
      "expected": "MATCH[prepare]\nMATCH[premium]\npost\nMATCH[pre]"
    },
    {
      "id": 47,
      "name": "Ends modifier",
      "code": "$pattern {$w$ends{ing}} {MATCH[$w]}\nrunning\nswimming\nsing\ning",
      "expected": "MATCH[running]\nMATCH[swimming]\nMATCH[sing]\nMATCH[ing]"
    },
    {
      "id": 48,
      "name": "Prefix modifier",
      "code": "$pattern {$w$prefix{pre}} {MATCH[$w]}\nprepare\npremium\npost\npre",
      "expected": "MATCH[prepare]\nMATCH[premium]\npost\npre"
    },
    {
      "id": 49,
      "name": "Suffix modifier",
      "code": "$pattern {$w$suffix{ing}} {MATCH[$w]}\nrunning\nswimming\nsing\ning",
      "expected": "MATCH[running]\nMATCH[swimming]\nMATCH[sing]\ning"
    },
    {
      "id": 50,
      "name": "Infix modifier",
      "code": "$pattern {$w$infix{in}} {MATCH[$w]}\npinball\nwindows\ninside\npin\nin",
      "expected": "MATCH[pinball]\nMATCH[windows]\ninside\npin\nin"
    },
    {
      "id": 51,
      "name": "Includes modifier",
      "code": "$pattern {$w$includes{in}} {MATCH[$w]}\npinball\nwindows\ninside\npin\nin",
      "expected": "MATCH[pinball]\nMATCH[windows]\nMATCH[inside]\nMATCH[pin]\nMATCH[in]"
    },
    {
      "id": 52,
      "name": "Nested: int modifier inside aliases",
      "code": "$pattern {$n$aliases{$x$int}{abc}{hello}} {MATCH[$n]}\n42\nabc\nhello\nxyz",
      "expected": "MATCH[42]\nMATCH[abc]\nMATCH[hello]\nxyz"
    },
    {
      "id": 53,
      "name": "Nested: aliases inside optional with anchor",
      "code": "$pattern {say $x$group{$y$aliases{hello}{hi}}?} {SAID[$x]}\nsay hello\nsay hi\nsay\nnothing",
      "expected": "SAID[hello]\nSAID[hi]\nSAID[]nothing"
    },
    {
      "id": 54,
      "name": "Nested: includes with nested aliases",
      "code": "$pattern {$w$includes{$x$aliases{cat}{dog}}} {HAS_PET[$w]}\nbigcatfoo\nhelldogend\nnothing",
      "expected": "HAS_PET[bigcatfoo]\nHAS_PET[helldogend]\nnothing"
    },
    {
      "id": 55,
      "name": "Nested: starts with nested optional",
      "code": "$pattern {$w$starts{un}} {MATCH[$w]}\nunhappy\nundo\nhappy",
      "expected": "MATCH[unhappy]\nMATCH[undo]\nhappy"
    },
    {
      "id": 56,
      "name": "Document operator",
      "code": "START $document END",
      "expected": "START START $document END END"
    },
    {
      "id": 57,
      "name": "$list with newline separator",
      "code": "$L$from{line1\nline2\nline3}$L$list{\n}$count",
      "expected": "3"
    },
    {
      "id": 58,
      "name": "Multi-block aliases (recursive)",
      "code": "$pattern {$x$aliases{foo}{bar}} {M[$x]}\nfoo and bar",
      "expected": "M[foo] andM[bar]"
    },
    {
      "id": 59,
      "name": "Changeoptional",
      "code": "$changesymbols{$}{[}{]}{!} $pattern [a!b] [MATCH]\nab and b",
      "expected": " MATCH and MATCH"
    },
    {
      "id": 60,
      "name": "Changequote (2 args)",
      "code": "$changesymbols{$}{<<}{>>}{?}$pattern <<x>> <<y>>\nx",
      "expected": "y"
    },
    {
      "id": 61,
      "name": "Multi-char optional marker",
      "code": "$changesymbols{#}{[}{]}{MAYBE} #pattern[#fooMAYBE][MATCH]\nfoo",
      "expected": " MATCH"
    },
    {
      "id": 62,
      "name": "Trivial Group",
      "code": "$pattern {$x$group{abc}} {OK-$x}\nabc",
      "expected": " OK-abc"
    },
    {
      "id": 64,
      "name": "Braced variable ambiguity resolution",
      "code": "$pattern {$id$word} {${id}x}\nfoo",
      "expected": "foox"
    },
    {
      "id": 65,
      "name": "Braced variable: non-identifier content not parsed as var",
      "code": "$pattern {$a$word} {${a}-suffix}\nfoo",
      "expected": " foo-suffix"
    },
    {
      "id": 66,
      "name": "Trailing sigil on literal: whitespace consumed",
      "code": "$pattern {hello$ world} {MATCH}\nhello   world",
      "expected": " MATCH"
    },
    {
      "id": 67,
      "name": "Trailing sigil on variable: whitespace consumed",
      "code": "$pattern {$a$ $b} {$a/$b}\nhello   world",
      "expected": " hello/world"
    },
    {
      "id": 68,
      "name": "Trailing sigil consumes newlines too",
      "code": "$pattern {$x$\n$y} {($x,$y)}\nfoo\nbar",
      "expected": " (foo,bar)"
    },
    {
      "id": 69,
      "name": "Braced variable: multiple in same replacement",
      "code": "$pattern {$first $last} {${last}, ${first}}\nJohn Doe",
      "expected": " Doe, John"
    },
    {
      "id": 70,
      "name": "Braced variable: unknown name kept as-is",
      "code": "$pattern {$x$word} {${x}suffix${unknown}}\nfoo",
      "expected": " foosuffix${unknown}"
    },
    {
      "id": 71,
      "name": "Priority system: basic reordering",
      "code": "$priority$1{Result: A} $priority$0{$pattern{A}{OK}}",
      "expected": "Result: OK"
    },
    {
      "id": 72,
      "name": "Priority system: recursive blocks",
      "code": "$priority$0{A $priority$1{B}} $priority$1{C}",
      "expected": "A B C"
    },
    {
      "id": 73,
      "name": "Priority system: side effects order",
      "code": "$priority$0{$pattern{X}{1} $priority$1{$pattern{X}{2}}} $priority$1{$pattern{X}{3}} X",
      "expected": "2"
    },
    {
      "id": 74,
      "name": "$document$original rework",
      "code": "$pattern{A}{OK} A - $document$original",
      "expected": "OK - $pattern{A}{OK} A - $document$original"
    },
    {
      "id": 75,
      "name": "$from chained assignment",
      "code": "$A$from{1} $B$from{$A$A} $B",
      "expected": "11"
    },
    {
      "id": 76,
      "name": "$from nested assignment",
      "code": "$X$from{ $Y$from{val} $Y } $X",
      "expected": "val"
    },
    {
      "id": 77,
      "name": "$from redefinition",
      "code": "$X$from{1} $X$from{2} $X",
      "expected": "2"
    },
    {
      "id": 78,
      "name": "$from multiple same line",
      "code": "$A$from{1}$B$from{2} $A+$B",
      "expected": "1+2"
    },
    {
      "id": 79,
      "name": "$from sigil escaping",
      "code": "$A$from{$$A} $A",
      "expected": "$A"
    },
    {
      "id": 80,
      "name": "$from with recursive content",
      "code": "$X$from{val} $pattern{$X}{OK} $X",
      "expected": "OK"
    },
    {
      "id": 81,
      "name": "$from multi-level chain",
      "code": "$A$from{1} $B$from{$A} $C$from{$B} $C",
      "expected": "1"
    },
    {
      "id": 82,
      "name": "$from dynamic pattern",
      "code": "$X$from{KEY} $pattern{$X}{VAL} KEY",
      "expected": "VAL"
    },
    {
      "id": 83,
      "name": "$from value persistence",
      "code": "$X$from{1} $Y$from{$X} $X$from{2} $Y",
      "expected": "1"
    },
    {
      "id": 84,
      "name": "$document$current verification",
      "code": "$X$from{VAL} $X - $document$current",
      "expected": "VAL -  VAL - $document$current"
    },
    {
      "id": 85,
      "name": "$list$get basic",
      "code": "$L$from{a,b,c} $L$list{,}$get{0}",
      "expected": "a"
    },
    {
      "id": 86,
      "name": "$list$get negative index",
      "code": "$L$from{a,b,c} $L$list{,}$get{-1}",
      "expected": "c"
    },
    {
      "id": 87,
      "name": "$list$get out of range",
      "code": "$L$from{a,b,c} $L$list{,}$get{99}",
      "expected": ""
    },
    {
      "id": 88,
      "name": "$list$get empty list",
      "code": "$L$from{} $L$list{,}$get{0}",
      "expected": ""
    },
    {
      "id": 89,
      "name": "$list$count basic",
      "code": "$L$from{a,b,c} $L$list{,}$count",
      "expected": "3"
    },
    {
      "id": 90,
      "name": "$list$count empty",
      "code": "$L$from{} $L$list{,}$count",
      "expected": "0"
    },
    {
      "id": 91,
      "name": "$list$push basic",
      "code": "$L$from{a,b} $L$list{,}$push{c} $L",
      "expected": "a,b,c"
    },
    {
      "id": 92,
      "name": "$list$push onto empty",
      "code": "$L$from{} $L$list{,}$push{x} $L",
      "expected": "x"
    },
    {
      "id": 93,
      "name": "$list$pop emits and mutates",
      "code": "$L$from{a,b,c} popped:$L$list{,}$pop rest:$L",
      "expected": "popped:c rest:a,b"
    },
    {
      "id": 94,
      "name": "$list$shift emits and mutates",
      "code": "$L$from{a,b,c} first:$L$list{,}$shift rest:$L",
      "expected": "first:a rest:b,c"
    },
    {
      "id": 95,
      "name": "$list$unshift basic",
      "code": "$L$from{b,c} $L$list{,}$unshift{a} $L",
      "expected": "a,b,c"
    },
    {
      "id": 96,
      "name": "$list$set replaces element",
      "code": "$L$from{a,b,c} $L$list{,}$set{1}{B} $L",
      "expected": "a,B,c"
    },
    {
      "id": 97,
      "name": "$list$set negative index",
      "code": "$L$from{a,b,c} $L$list{,}$set{-1}{Z} $L",
      "expected": "a,b,Z"
    },
    {
      "id": 98,
      "name": "$list$insert at middle",
      "code": "$L$from{a,c} $L$list{,}$insert{1}{b} $L",
      "expected": "a,b,c"
    },
    {
      "id": 99,
      "name": "$list$remove at index",
      "code": "$L$from{a,b,c} $L$list{,}$remove{1} $L",
      "expected": "a,c"
    },
    {
      "id": 100,
      "name": "$list$swap two elements",
      "code": "$L$from{a,b,c} $L$list{,}$swap{0}{2} $L",
      "expected": "c,b,a"
    },
    {
      "id": 101,
      "name": "$list$reverse basic",
      "code": "$L$from{a,b,c} $L$list{,}$reverse $L",
      "expected": "c,b,a"
    },
    {
      "id": 102,
      "name": "$list$join changes separator",
      "code": "$L$from{a,b,c} $L$list{,}$join{ | }",
      "expected": "a | b | c"
    },
    {
      "id": 103,
      "name": "$list multi-char separator",
      "code": "$L$from{foo::bar::baz} $L$list{::}$get{1}",
      "expected": "bar"
    },
    {
      "id": 104,
      "name": "$list separator processed from variable",
      "code": "$SEP$from{,} $L$from{x,y,z} $L$list{$SEP}$get{2}",
      "expected": "z"
    },
    {
      "id": 105,
      "name": "$list empty sep: char-by-char count",
      "code": "$L$from{abc} $L$list{}$count",
      "expected": "3"
    },
    {
      "id": 106,
      "name": "$list empty sep: char-by-char get",
      "code": "$L$from{hello} $L$list{}$get{1}",
      "expected": "e"
    },
    {
      "id": 107,
      "name": "$list empty sep: reverse string",
      "code": "$L$from{abc} $L$list{}$reverse $L",
      "expected": "cba"
    },
    {
      "id": 108,
      "name": "$compare match returns value",
      "code": "$A$from{hello} $A$compare{hello}",
      "expected": "hello"
    },
    {
      "id": 109,
      "name": "$compare mismatch returns empty",
      "code": "$A$from{hello} $A$compare{world}",
      "expected": ""
    },
    {
      "id": 110,
      "name": "$compare both sides variables",
      "code": "$A$from{x} $B$from{x} $A$compare{$B}",
      "expected": "x"
    },
    {
      "id": 111,
      "name": "$compare both sides variables mismatch",
      "code": "$A$from{x} $B$from{y} $A$compare{$B}",
      "expected": ""
    },
    {
      "id": 112,
      "name": "$then with non-empty value emits content",
      "code": "$A$from{hello} $A$then{world}",
      "expected": "world"
    },
    {
      "id": 113,
      "name": "$then with empty value emits empty",
      "code": "${}$then{world}",
      "expected": ""
    },
    {
      "id": 114,
      "name": "$else with empty value emits content",
      "code": "${}$else{fallback}",
      "expected": "fallback"
    },
    {
      "id": 115,
      "name": "$else with non-empty value passes through",
      "code": "$A$from{hello} $A$else{fallback}",
      "expected": "hello"
    },
    {
      "id": 116,
      "name": "$compare$then match",
      "code": "$A$from{abc} $A$compare{abc}$then{YES}",
      "expected": "YES"
    },
    {
      "id": 117,
      "name": "$compare$then mismatch gives empty",
      "code": "$A$from{abc} $A$compare{xyz}$then{YES}",
      "expected": ""
    },
    {
      "id": 118,
