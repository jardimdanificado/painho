============================================================
              DUNGEON OF PAPAGAIO
============================================================

$HERO_HP$from{....................}
$MONSTER_HP$from{............}
$HERO_ROLLS$from{4,2,6,3,5}
$MONSTER_ROLLS$from{3,1,4,2,3}
$TURN$from{.}
$LOG$from{}

$while{CONTINUE}{$BOTH_ALIVE$from{$HERO_HP$then{$MONSTER_HP$then{1}$else{0}}$else{0}}$repeat{$BOTH_ALIVE}{$ROUND_NUM$from{$TURN$list{}$count}$H_DMG$from{$HERO_ROLLS$list{,}$shift}$H_DMG$from{$H_DMG$else{1}}$M_DMG$from{$MONSTER_ROLLS$list{,}$shift}$M_DMG$from{$M_DMG$else{1}}$HERO_HP$from{$HERO_HP$slice{$M_DMG}}$MONSTER_HP$from{$MONSTER_HP$slice{$H_DMG}}$H_BAR$from{Hero HP:    $HERO_HP$list{}$count / 20}$M_BAR$from{Monster HP: $MONSTER_HP$list{}$count / 12}$R_LOG$from{
--------------------------------------------------
ROUND $ROUND_NUM
Hero attacks for $H_DMG damage!
Monster attacks for $M_DMG damage!
$H_BAR
$M_BAR
}$LOG$from{$LOG $R_LOG}$TURN$from{$TURN.}}$HERO_HP$then{$MONSTER_HP$then{CONTINUE}$else{STOP}}$else{STOP}}

$repeat{$HERO_HP$then{1}$else{0}}{
  $LOG$from{$LOG
MONSTER IS VAPORIZED! Victory!}
}
$repeat{$HERO_HP$then{0}$else{1}}{
  $LOG$from{$LOG
HERO HAS FALLEN! Game Over!}
}

$LOG
