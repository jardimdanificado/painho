#include <windows.h>

// Resource IDs (must match papagaiocc_win.c)
#define IDR_PAPAGAIO_EXE  101
#define IDR_CLANG_EXE     102
#define IDR_SDK_H         103
#define IDR_PRE_PAP       104

// Macros to stringify paths passed from the compiler
#define STRINGIFY(x) #x
#define TOSTRING(x) STRINGIFY(x)

#ifndef PAPAGAIO_EXE_PATH
#define PAPAGAIO_EXE_PATH ../papagaio.exe
#endif

#ifndef SDK_H_PATH
#define SDK_H_PATH "../lib/wasm-libc/include/lib.c"
#endif

#ifndef PRE_PAP_PATH
#define PRE_PAP_PATH ../lib/wasm-libc/preprocessor.pap
#endif

#ifndef CLANG_EXE_PATH
#define CLANG_EXE_PATH ../clang.exe
#endif

IDR_PAPAGAIO_EXE  RCDATA  TOSTRING(PAPAGAIO_EXE_PATH)
IDR_SDK_H         RCDATA  TOSTRING(SDK_H_PATH)
IDR_PRE_PAP       RCDATA  TOSTRING(PRE_PAP_PATH)

#ifdef EMBED_CLANG
IDR_CLANG_EXE     RCDATA  TOSTRING(CLANG_EXE_PATH)
#endif

// Version info
VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription",  "Papagaio Standalone Wasm Compiler"
            VALUE "FileVersion",      "1.0.0"
            VALUE "InternalName",     "papagaiocc"
            VALUE "OriginalFilename", "papagaiocc.exe"
            VALUE "ProductName",      "Papagaio"
            VALUE "ProductVersion",   "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
